rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Qualquer um pode ler (arquivos públicos)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Regras específicas de upload
    match /plantas_imagens/{userId}/{filename} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    match /plantas_modelos/{userId}/{filename} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 50 * 1024 * 1024; // 50 MB
    }

    match /plantas_audios/{userId}/{filename} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    match /plantas_audiodescricoes/{userId}/{filename} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }
  }
}
