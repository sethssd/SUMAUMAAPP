rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    function isLoggedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      // Retorna o 'role' se o documento existir, ou 'user' se não existir.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    // --- REGRAS PARA "PLANTAS" ---
    match /plantas/{plantaId} {
      allow read: if true;
      
      // Regra de CRIAR: Valida o cargo e garante que o creatorId não seja forjado
      allow create: if isLoggedIn() && (
                      getRole() == 'super_admin' || 
                      (getRole() == 'escritor' && request.resource.data.creatorId == request.auth.uid)
                    );
                    
      // Regra de ATUALIZAR:
      allow update: if isLoggedIn() && (getRole() == 'escritor' || getRole() == 'super_admin');
      
      // Regra de DELETAR: Revalida o cargo e a autoria
      allow delete: if isLoggedIn() && (
                      // 1. O Super Admin pode deletar...
                      getRole() == 'super_admin' || 
                      // 2. OU o dono (se ainda for escritor) pode deletar
                      (getRole() == 'escritor' && resource.data.creatorId == request.auth.uid)
                    );
    }

    // --- REGRAS PARA "USUÁRIOS" ---
    match /users/{userId} {
      // Super admin gerencia a coleção inteira
      allow list, write: if isLoggedIn() && getRole() == 'super_admin';
      // Usuário logado lê o próprio perfil
      allow get: if isLoggedIn() && request.auth.uid == userId;
      // Usuário logado cria o próprio perfil no primeiro login (auto-registro)
      allow create: if isLoggedIn() && request.auth.uid == userId;
    }
    
    // --- REGRAS PARA "SUGESTOES" ---
    match /sugestoes/{sugestaoId} {
      allow create: if isLoggedIn() &&
                    request.resource.data.keys().hasAll(['texto', 'timestamp', 'lido']) &&
                    request.resource.data.texto is string &&
                    request.resource.data.texto.size() <= 1000 &&
                    request.resource.data.lido == false;
      allow read, update, delete: if false;
    }

    // --- REGRAS PARA "SOLICITAÇÕES DE CARGO" ---
    match /role_requests/{userId} {
      // Qualquer usuário logado pode criar e ler seu próprio pedido
      allow create, get: if isLoggedIn() && request.auth.uid == userId;
      // Super admin pode listar e deletar solicitações
      allow list, delete: if isLoggedIn() && getRole() == 'super_admin';
    }

    // --- REGRAS PARA "DESTAQUES" (NOTÍCIAS) ---
    match /destaques/{destaqueId} {
      allow read: if true;
      allow write: if isLoggedIn() && (getRole() == 'super_admin' || getRole() == 'admin' || getRole() == 'escritor');
    }
  }
}
